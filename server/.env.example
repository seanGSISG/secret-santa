# ===========================================
# SECRET SANTA - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# App Environment (development or production)
NODE_ENV=production

# Server port (default: 3001)
PORT=3001

# Your app's public URL (used in emails and CORS)
# For local Docker: http://localhost:3001
# For production: https://your-domain.com
CLIENT_URL=http://localhost:3001

# ===========================================
# EMAIL CONFIGURATION (Gmail)
# ===========================================
# Required for sending notifications to participants
#
# HOW TO GET A GMAIL APP PASSWORD:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification (required for app passwords)
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" and "Other (Custom name)"
# 5. Type "Secret Santa" and click Generate
# 6. Copy the 16-character password (remove spaces)
#
# NOTE: If you skip email setup, the app will still work
# but participants won't receive email notifications

EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================
# If you want to use a different email provider, you can configure SMTP settings here.
# Port 587 uses STARTTLS (secure=false); port 465 uses implicit TLS (secure=true).
# Example for Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# Optional sender address; SMTP authentication still uses EMAIL_USER and EMAIL_PASS.
# EMAIL_FROM=santa@example.com

# Set to false to disable wishlist pages, emails, and API routes.
ENABLE_WISHLIST=true

# Public registration (comma-separated exact email domains, no wildcards).
# Leave empty to disable public registration.
# Example: ALLOWED_EMAIL_DOMAINS=molinier.io,example.com
ALLOWED_EMAIL_DOMAINS=
