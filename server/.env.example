# ===========================================
# SECRET SANTA - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# App Environment (development or production)
NODE_ENV=production

# Server port (default: 3001)
PORT=3001

# Your app's public URL (used in emails and CORS)
# For local Docker: http://localhost:3001
# For production: https://your-domain.com
CLIENT_URL=http://localhost:3001

# ===========================================
# EMAIL CONFIGURATION (Gmail)
# ===========================================
# Required for sending notifications to participants
#
# HOW TO GET A GMAIL APP PASSWORD:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification (required for app passwords)
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" and "Other (Custom name)"
# 5. Type "Secret Santa" and click Generate
# 6. Copy the 16-character password (remove spaces)
#
# NOTE: If you skip email setup, the app will still work
# but participants won't receive email notifications

EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================
# If you want to use a different email provider, you can configure SMTP settings here.
# Port 587 uses STARTTLS (secure=false); port 465 uses implicit TLS (secure=true).
# Example for Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# Optional sender address; SMTP authentication still uses EMAIL_USER and EMAIL_PASS.
# EMAIL_FROM=santa@example.com

# Set to false to disable wishlist pages, emails, and API routes.
ENABLE_WISHLIST=true

# Public registration (comma-separated exact email domains, no wildcards).
# Leave empty to disable public registration.
# Example: ALLOWED_EMAIL_DOMAINS=example.org,example.com
ALLOWED_EMAIL_DOMAINS=

# Public-facing event branding (visible to participants).
PAGE_TITLE=Secret Santa révèle
GAME_TITLE=Secret Santa
# Optional shared text for both languages:
# GAME_SUBTITLE=Inscrivez-vous et partagez la joie des cadeaux.
# WELCOME_MESSAGE=Bienvenue ! Inscrivez-vous pour participer.
# Optional language-specific versions take precedence over shared text:
# GAME_SUBTITLE_FR=Inscrivez-vous et partagez la joie des cadeaux.
# GAME_SUBTITLE_EN=Sign up and share the joy of giving.
# WELCOME_MESSAGE_FR=Bienvenue ! Inscrivez-vous pour participer.
# WELCOME_MESSAGE_EN=Welcome! Sign up to take part.
# Optional custom registration rules shown on the registration page.
# Keep email domain rules in this text yourself if you want participants to see them;
# ALLOWED_EMAIL_DOMAINS is never exposed by the public configuration endpoint.
# REGISTRATION_RULES_FR="Inscription avec une adresse e-mail @example.com.\nLimite de dépense : 30 €."
# REGISTRATION_RULES_EN="Register with an @example.com email address.\nSpending limit: €30."
# Optional gift spending limit in euros, shown after registration.
# GIFT_SPENDING_LIMIT_EUR=30

# Optional event milestones. Dates must use YYYY-MM-DD.
# Labels can be a string (same text in both languages) or translated as below.
# EVENT_MILESTONES=[{"label":{"fr":"Fin des inscriptions","en":"Registration deadline"},"date":"2026-11-20"},{"label":{"fr":"Tirage au sort","en":"Match draw"},"date":"2026-11-25"},{"label":{"fr":"Livraison des cadeaux","en":"Gift delivery deadline"},"date":"2026-12-20"}]
